{
  "domain": "yunmai_scale",
  "name": "Yunmai Scale",
  "bluetooth": [
    {
      "local_name": "YUNMAI-SIGNAL*",
      "connectable": true
    },
    {
      "local_name": "YUNMAI-ISM*",
      "connectable": true
    },
    {
      "local_name": "YUNMAI-ISC2P*",
      "connectable": true
    },
    {
      "local_name": "YUNMAI-Scale-3",
      "connectable": true
    },
    {
      "local_name": "YUNMAI-ISSE*",
      "connectable": true
    }
